	(text "PCB harnesses are J11..J42. SW1..SW30 playfield; SW31 START; SW32 BACK.\nNo PCB footprints are assigned to cabinet buttons. Board-side headers and mating housings are specified in BOM."
		(exclude_from_sim no)
		(at 20 258 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "5e18cc8c-84c4-4e79-bf6c-1a2a4d3b432a")
	)
	(text "Functional pin names identify the wires; they are NOT manufacturer terminal numbers.\nMicroswitch COM/NO closes when pressed. Lamp has two separate terminals; observe LED polarity.\nThe light and switch circuits must remain separate. Insulate unused NC contacts, if present.\nAdafruit 1194 includes a series LED resistor. Verify EG STARTS 12 V lamp module and current before use."
		(exclude_from_sim no)
		(at 20 30 0)
		(effects
			(font
				(size 1.15 1.15)
			)
			(justify left)
		)
		(uuid "b35739ff-317a-4241-95b2-1466230fda8e")
	)
